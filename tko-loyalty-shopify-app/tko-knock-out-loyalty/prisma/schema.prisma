generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model Tier {
  id          String        @id @default(uuid())
  name        String
  description String?
  minPoints   Float
  maxPoints   Float?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  customers   Customer[]
  benefits    TierBenefit[]
}

model TierBenefit {
  id          String   @id @default(uuid())
  name        String
  description String
  tierId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tier        Tier     @relation(fields: [tierId], references: [id], onDelete: Cascade)
}

model Customer {
  id            String             @id
  shopifyId     BigInt             @unique
  email         String?
  firstName     String?
  lastName      String?
  phone         String?
  totalSpend    Float              @default(0)
  numberOfOrders Int               @default(0)
  tierId        String?
  metafieldId   String?            @unique
  lastOrderDate DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  spendPoints   Float              @default(0)
  bonusPoints   Float              @default(0)
  totalPoints   Float              @default(0)
  tags          String?            // Comma-separated tags from Shopify
  city          String?
  province      String?
  country       String?
  lastSyncAt    DateTime?          // Track when customer data was last synced
  isActive      Boolean            @default(true) // Active in last 30 days
  tier          Tier?              @relation(fields: [tierId], references: [id])
  transactions  PointTransaction[]
  pendingOrders PendingOrder[]

  @@index([totalPoints])
  @@index([email])
  @@index([phone])
  @@index([lastSyncAt])
  @@index([isActive])
  @@index([numberOfOrders])
  @@map("Customer")
}

model PointEvent {
  id              String             @id @default(uuid())
  name            String
  description     String?
  startDate       DateTime
  endDate         DateTime
  eventType       String
  tags            String?
  collections     String?
  productIds      String?
  channel         String             @default("both")
  bonusPercentage Float
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  usageCount      Int                @default(0)
  pointsAwarded   Float              @default(0)
  lastUsed        DateTime?
  transactions    PointTransaction[]

  @@map("PointEvent")
}

model PointTransaction {
  id          String      @id @default(uuid())
  customerId  String
  type        String
  amount      Float
  orderId     String?
  eventId     String?
  description String?
  createdAt   DateTime    @default(now())
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  event       PointEvent? @relation(fields: [eventId], references: [id])

  @@index([customerId])
  @@index([eventId])
  @@map("PointTransaction")
}

model PendingOrder {
  id              String   @id @default(uuid())
  shopifyOrderId  String   @unique
  customerId      String
  orderData       String   // JSON string of order data
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([shopifyOrderId])
  @@index([customerId])
  @@map("PendingOrder")
}

model DashboardMetrics {
  id                String   @id @default("dashboard") // Single row for dashboard metrics
  totalCustomers    Int      @default(0)
  activeCustomers   Int      @default(0)
  totalSpent        Float    @default(0)
  monthSpent        Float    @default(0)
  yearSpent         Float    @default(0)
  tierCounts        String   @default("{}") // JSON string of tier counts
  topCompetitorsToday String @default("[]") // JSON string of top competitors today
  topCompetitorsMonth String @default("[]") // JSON string of top competitors this month
  lastCalculated    DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("DashboardMetrics")
}
