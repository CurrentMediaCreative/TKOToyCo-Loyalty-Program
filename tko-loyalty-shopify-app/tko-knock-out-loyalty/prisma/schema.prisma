generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model Tier {
  id          String        @id @default(uuid())
  name        String
  description String?
  minPoints   Float
  maxPoints   Float?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  benefits    TierBenefit[]
  customers   Customer[]
}

model TierBenefit {
  id          String   @id @default(uuid())
  name        String
  description String
  tierId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tier        Tier     @relation(fields: [tierId], references: [id], onDelete: Cascade)
}

model Customer {
  id            String             @id
  shopifyId     BigInt             @unique
  email         String?
  firstName     String?
  lastName      String?
  totalSpend    Float              @default(0)
  tierId        String?
  metafieldId   String?            @unique
  lastOrderDate DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  spendPoints   Float              @default(0)
  bonusPoints   Float              @default(0)
  totalPoints   Float              @default(0)
  tier          Tier?              @relation(fields: [tierId], references: [id])
  transactions  PointTransaction[]

  @@index([totalPoints])
  @@map("Customer")
}

model PointEvent {
  id              String             @id @default(uuid())
  name            String
  description     String?
  startDate       DateTime
  endDate         DateTime
  eventType       String    // "category" or "product-specific"
  tags            String?   // JSON array of tags for category-based events (AND logic)
  productIds      String?   // JSON array of product IDs for product-specific events
  bonusPercentage Float
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  usageCount      Int                @default(0)
  pointsAwarded   Float              @default(0)
  lastUsed        DateTime?
  transactions    PointTransaction[]

  @@map("PointEvent")
}

model PointTransaction {
  id          String      @id @default(uuid())
  customerId  String
  type        String
  amount      Float
  orderId     String?
  eventId     String?
  description String?
  createdAt   DateTime    @default(now())
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  event       PointEvent? @relation(fields: [eventId], references: [id])

  @@index([customerId])
  @@index([eventId])
  @@map("PointTransaction")
}
