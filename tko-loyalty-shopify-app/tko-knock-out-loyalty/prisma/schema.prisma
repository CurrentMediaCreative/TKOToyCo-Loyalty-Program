generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model Tier {
  id          String        @id @default(uuid())
  name        String
  description String?
  minPoints   Float
  maxPoints   Float?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  customers   Customer[]
  benefits    TierBenefit[]
}

model TierBenefit {
  id          String   @id @default(uuid())
  name        String
  description String
  tierId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tier        Tier     @relation(fields: [tierId], references: [id], onDelete: Cascade)
}

model Customer {
  id            String             @id
  shopifyId     BigInt             @unique
  email         String?
  firstName     String?
  lastName      String?
  phone         String?
  totalSpend    Float              @default(0)
  numberOfOrders Int               @default(0)
  tierId        String?
  metafieldId   String?            @unique
  lastOrderDate DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  spendPoints   Float              @default(0)
  bonusPoints   Float              @default(0)
  totalPoints   Float              @default(0)
  tags          String?            // Comma-separated tags from Shopify
  city          String?
  province      String?
  country       String?
  lastSyncAt    DateTime?          // Track when customer data was last synced
  isActive      Boolean            @default(true) // Active in last 30 days
  tier          Tier?              @relation(fields: [tierId], references: [id])
  transactions  PointTransaction[]
  pendingOrders PendingOrder[]
  orders        Order[]            // Relationship to orders

  @@index([totalPoints])
  @@index([email])
  @@index([phone])
  @@index([lastSyncAt])
  @@index([isActive])
  @@index([numberOfOrders])
  @@map("Customer")
}

model Order {
  id                String    @id @default(uuid())
  shopifyId         BigInt    @unique
  customerId        String?
  customer          Customer? @relation(fields: [customerId], references: [id])
  
  // Financial data
  totalAmount       Decimal   @db.Decimal(10, 2)
  subtotalAmount    Decimal   @db.Decimal(10, 2)
  taxAmount         Decimal   @db.Decimal(10, 2)
  shippingAmount    Decimal   @db.Decimal(10, 2)
  discountAmount    Decimal   @db.Decimal(10, 2)
  
  // Status and fulfillment
  financialStatus   String    // paid, pending, refunded, etc.
  fulfillmentStatus String?   // fulfilled, partial, unfulfilled
  
  // Dates
  createdAt         DateTime
  processedAt       DateTime?
  fulfilledAt       DateTime?
  
  // Location and source
  sourceUrl         String?
  referringSite     String?
  landingSite       String?
  
  // Order details
  orderNumber       Int
  tags              String?
  note              String?
  
  // Tracking
  lastSyncAt        DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([shopifyId])
  @@index([customerId])
  @@index([processedAt])
  @@index([createdAt])
  @@index([financialStatus])
  @@index([fulfillmentStatus])
  @@index([totalAmount])
  @@map("Order")
}

model PointEvent {
  id              String                  @id @default(uuid())
  name            String
  description     String?
  startDate       DateTime
  endDate         DateTime
  eventType       String
  tags            String?
  collections     String?
  productIds      String?
  channel         String                  @default("both")
  bonusPercentage Float
  isActive        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  usageCount      Int                     @default(0)
  pointsAwarded   Float                   @default(0)
  lastUsed        DateTime?
  transactions    PointTransaction[]
  orderProcessing EventOrderProcessing[]

  @@map("PointEvent")
}

model PointTransaction {
  id          String      @id @default(uuid())
  customerId  String
  type        String
  amount      Float
  orderId     String?
  eventId     String?
  description String?
  createdAt   DateTime    @default(now())
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  event       PointEvent? @relation(fields: [eventId], references: [id])

  @@index([customerId])
  @@index([eventId])
  @@map("PointTransaction")
}

model PendingOrder {
  id              String   @id @default(uuid())
  shopifyOrderId  String   @unique
  customerId      String
  orderData       String   // JSON string of order data
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([shopifyOrderId])
  @@index([customerId])
  @@map("PendingOrder")
}

model EventOrderProcessing {
  id                 String     @id @default(uuid())
  eventId            String
  orderId            String
  orderNumber        String
  customerName       String?
  orderTotal         Decimal    @db.Decimal(10, 2)
  processed          Boolean    @default(false)
  qualified          Boolean    @default(false)
  bonusPointsAwarded Int        @default(0)
  processedAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  event              PointEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, orderId])
  @@map("EventOrderProcessing")
}

model DashboardMetrics {
  id                String   @id @default("dashboard") // Single row for dashboard metrics
  totalCustomers    Int      @default(0)
  activeCustomers   Int      @default(0)
  totalSpent        Float    @default(0)
  monthSpent        Float    @default(0)
  yearSpent         Float    @default(0)
  tierCounts        String   @default("{}") // JSON string of tier counts
  topCompetitorsToday String @default("[]") // JSON string of top competitors today
  topCompetitorsMonth String @default("[]") // JSON string of top competitors this month
  lastCalculated    DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("DashboardMetrics")
}

model WebhookEvent {
  id           String   @id @default(uuid())
  eventId      String   @unique // X-Shopify-Event-Id header
  topic        String   // X-Shopify-Topic header
  shop         String   // X-Shopify-Shop-Domain header
  status       String   // processing, completed, failed
  orderId      String?  // Associated order ID if applicable
  customerId   String?  // Associated customer ID if applicable
  errorMessage String?  // Error details if failed
  processedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([eventId])
  @@index([topic])
  @@index([shop])
  @@index([status])
  @@index([processedAt])
  @@map("WebhookEvent")
}
